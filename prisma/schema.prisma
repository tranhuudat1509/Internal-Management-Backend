enum OrderStatus {
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum DimensionUnit {
  CM
  MM
  M
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id Int @id @default(autoincrement())

  companyName String
  city        String?
  address     String?
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts CustomerContact[]

  orders Order[]

  specialPrices CustomerProductPrice[]
}

model CustomerContact {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  contactName String
  phone       String?
  email       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id Int @id @default(autoincrement())

  code String @unique
  name String

  category String
  material String?

  length Int?
  width  Int?
  height Int?

  dimensionUnit DimensionUnit @default(CM)

  weight Float?

  basePrice Float

  unit String

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  specialPrices CustomerProductPrice[]

  colors ProductColor[]

  images ProductImage[]
}

model ProductColor {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images ProductImage[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductImage {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  colorId Int?
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  fileName String @unique

  originalName String?

  sortOrder Int @default(0)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([colorId])
}

model Order {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  status OrderStatus @default(IN_PROGRESS)

  orderDate DateTime @default(now())

  deliveryDate DateTime?

  notes String?

  discount Float @default(0)

  subtotal Float @default(0)

  total Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  payments Payment[]
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  unitPrice Float

  lineTotal Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount Float

  paymentMethod PaymentMethod

  paymentDate DateTime @default(now())

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerProductPrice {
  id Int @id @default(autoincrement())

  customerId Int
  productId  Int

  price Float

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model User {
  id Int @id @default(autoincrement())

  name String

  username String @unique

  passwordHash String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
